-- FPCU 应用在 EADAF 中注册（幂等）
-- redirect_uri 使用「跟随 Host」后缀，换服务器 IP/域名无需改库
-- 变量：FPCU2_APPLICATION_ID / FPCU2_APP_SECRET / FPCU2_API_HOST_PORT / FPCU2_WEB_HOST_PORT

INSERT INTO eadaf.applications (
  application_id,
  name,
  code,
  status,
  sso_enabled,
  sso_config,
  api_enabled,
  api_connect_config,
  bizdata_scope_codes,
  builtin_api_scope,
  description
) VALUES (
  '${FPCU2_APPLICATION_ID}',
  'FPCU设备管理',
  'FPCU',
  'ACTIVE',
  true,
  jsonb_build_object(
    'client_id', 'FPCU',
    'client_secret', '${FPCU2_APP_SECRET}',
    'redirect_uri', ':${FPCU2_API_HOST_PORT}/auth/callback',
    'redirect_uri_use_system_host', true,
    'redirect_mode', 'HEADER_REDIRECT',
    'frontend_url', ':${FPCU2_WEB_HOST_PORT}'
  ),
  true,
  jsonb_build_object('app_secret', '${FPCU2_APP_SECRET}'),
  '["FPCU"]'::jsonb,
  jsonb_build_object(
    'permissionCodes', ARRAY[
      'bizdata:entity:schema',
      'bizdata:scope:list',
      'bizdata:scope:exists',
      'bizdata:scope-doc:list',
      'bizdata:scope-doc:get',
      'bizdata:scope-doc:upsert',
      'bizdata:entity:list',
      'bizdata:entity:exists',
      'bizdata:entity:create',
      'bizdata:entity:get',
      'bizdata:entity:update',
      'bizdata:entity:delete',
      'bizdata:entity:save_fields',
      'bizdata:enum:list',
      'bizdata:enum:exists',
      'bizdata:enum:create',
      'bizdata:relation:list',
      'bizdata:relation:create',
      'bizdata:materialization:preview',
      'bizdata:materialization:execute',
      'bizdata:materialization:status',
      'bizdata:materialization:runs',
      'bizdata:materialization:table_schema',
      'bizdata:materialization:table_rows',
      'bizdata:connection:list',
      'bizdata:connection:create',
      'bizdata:connection:test',
      'storage:bucket:list',
      'storage:bucket:create',
      'storage:object:list',
      'storage:object:upload',
      'storage:object:download',
      'storage:object:preview'
    ]
  ),
  'FPCU2 指纹比对网关（离线部署自动注册）'
)
ON CONFLICT (code) DO UPDATE SET
  application_id = EXCLUDED.application_id,
  name = EXCLUDED.name,
  status = EXCLUDED.status,
  sso_enabled = EXCLUDED.sso_enabled,
  sso_config = EXCLUDED.sso_config,
  api_enabled = EXCLUDED.api_enabled,
  api_connect_config = EXCLUDED.api_connect_config,
  bizdata_scope_codes = EXCLUDED.bizdata_scope_codes,
  builtin_api_scope = EXCLUDED.builtin_api_scope,
  description = EXCLUDED.description,
  updated_at = CURRENT_TIMESTAMP;

