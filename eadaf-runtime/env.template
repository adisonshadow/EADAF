NODE_ENV=production

# 浏览器访问的服务器 IP 或主机名（不含 http://）。部署前请改成实际地址。
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http

# 宿主机对外端口（容器内仍是 9527 / 9526）
EADAF_WEB_HOST_PORT=9527
EADAF_API_HOST_PORT=9526

# 由 PUBLIC_HOST 与 EADAF_WEB_HOST_PORT 推导（平台自身展示用；业务应用对外 URL 跟随浏览器 Host）
EADAF_PUBLIC_URL=http://localhost:9527

# —— 业务应用（如 FPCU2）运行时 ——
# 容器内访问 EADAF API（服务名，与客户 IP/域名无关）
EADAF_API_BASE_URL=http://eadaf-api:9526
# 仅端口：浏览器用当前 hostname + 端口拼对外地址，换服务器/域名不必改
FPCU2_WEB_HOST_PORT=13308
FPCU2_API_HOST_PORT=13303
FPCU2_APPLICATION_ID=10000000-0001-4000-8000-000000006666
FPCU2_APP_SECRET=62bb0941354d3e506ed5b7d9126f2fd50655e0966d2695d127e3758477b8ed07
# 不要再配置 FRONTEND_URL / SSO_CALLBACK_URL 绝对地址；SSO 使用「跟随 Host」

# ---- 业务应用运行时（FPCU2 等）：一般只需端口，不要写死客户 IP/域名 ----
# BFF → EADAF API（Docker 内网服务名；与浏览器 Host 无关）
EADAF_API_BASE_URL=http://eadaf-api:9526
# 浏览器侧由「当前 hostname + 下列端口」拼对外 URL（SSO 跳转 / 扫码 base_url）
FPCU2_WEB_HOST_PORT=13308
FPCU2_API_HOST_PORT=13303
FPCU2_APPLICATION_ID=10000000-0001-4000-8000-000000006666
FPCU2_APP_SECRET=62bb0941354d3e506ed5b7d9126f2fd50655e0966d2695d127e3758477b8ed07
FPCU2_SSO_APPLICATION_ID=10000000-0001-4000-8000-000000006666
# 特殊反代才需要强制绝对地址（默认不要设）
# FRONTEND_URL_FORCE=1
# FRONTEND_URL=https://app.example.com
# EADAF_FRONTEND_URL_FORCE=1
# EADAF_FRONTEND_URL=https://eadaf.example.com

# PostgreSQL（容器内互联用服务名；宿主机映射见 POSTGRES_HOST_PORT）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=35432
POSTGRES_DATABASE=eadaf_db
POSTGRES_USER=my_name
POSTGRES_PASSWORD=123456
POSTGRES_SCHEMA=uac
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=2000
POSTGRES_SSL=false

DB_BACKUP_DIR=/data/db-backup

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=36379
REDIS_PASSWORD=

# MySQL（BizData 外部库可选）
MYSQL_HOST_PORT=13306
MYSQL_ROOT_PASSWORD=Root@123456
MYSQL_DATABASE=bizdata

# API（容器内监听端口，与宿主机映射无关）
API_PORT=9526
API_HOST=0.0.0.0
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Security — 上线前务必修改
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

LOGIN_VERIFY_ENABLED=false
LOGIN_VERIFY_EXPIRES_IN=300

SSO_REDIRECT_MODE=POST_REDIRECT

UPLOAD_DEFAULT_TYPE=image

# Logging（绑定宿主机 ./logs/api）
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/data/logs/app.log
LOG_ROTATION_MAX_SIZE=20m
LOG_ROTATION_MAX_FILES=14d
LOG_ROTATION_ZIPPED=true
LOG_ERROR_MAX_FILES=30d
LOG_EXCEPTIONS_MAX_FILES=30d
LOG_REJECTIONS_MAX_FILES=30d

# AI Base — 上线前务必修改为 64 位 hex
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AI_UPSTREAM_TIMEOUT_MS=60000

SYSTEM_APPLICATION_ID=10000000-0000-4000-8000-000000000002
SYSTEM_APPLICATION_SECRET=
# 文件在 MinIO 独立卷，不在 API 容器磁盘。升级重建 API 不会带走已上传文件。
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=eadaf
MINIO_SECRET_KEY=eadaf-minio-secret
MINIO_BUCKET=eadaf
MINIO_ROOT_USER=eadaf
MINIO_ROOT_PASSWORD=eadaf-minio-secret
SYSTEM_STORAGE_BUCKET_CODE=eadaf-system
SYSTEM_STORAGE_BUCKET_NAME=EADAF系统资源
