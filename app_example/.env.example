# app_example 示例应用环境变量（开发用；密钥类配置不要提交）
# 复制为 .env.development 后按需修改：cp .env.example .env.development

# EADAF 后端地址。留空/默认走 vite proxy（/api → http://localhost:29526）
VITE_API_BASE=/api

# EADAF 里注册的应用 ID（SSO 登录用；也是 AI 助手识别调用方的 applicationId）
VITE_SSO_APPLICATION_ID=77777777-7777-4777-8777-777777777701

# EADAF 管理端地址：SSO 登录会跳到这里
VITE_SSO_EADAF_FRONTEND=http://localhost:29527

# EADAF 中的 AI Scope（该示例的 Skill / Tool 归属）；留空则用平台默认
VITE_DEMO_SCOPE_SLUG=sales-demo
