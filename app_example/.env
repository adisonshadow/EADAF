# app_example 示例应用环境变量（随仓库入库）
# VITE_* 会被 Vite 打进浏览器产物，只放公开值；不带 VITE_ 前缀的不会暴露给浏览器
# 个人 / 机器相关的覆盖请写进 .env.local（已被 .gitignore 忽略）

# EADAF 后端地址。留空/默认走 vite proxy（/api → http://localhost:29526）
VITE_API_BASE=/api

# EADAF 里注册的应用 ID（SSO 登录用；也是 AI 助手识别调用方的 applicationId）
VITE_SSO_APPLICATION_ID=1e71c653-630f-4006-b6df-081172b15752

# EADAF 管理端地址：SSO 登录会跳到这里
VITE_SSO_EADAF_FRONTEND=http://localhost:29527

# EADAF 中的 AI Scope（该示例的 Skill / Tool 归属）；留空则用平台默认
VITE_DEMO_SCOPE_SLUG=YS

# EADAF 应用统一密钥（管理台「三方应用 → SSO → 密钥管理」里生成的那把）
# 故意不加 VITE_ 前缀：Vite 只把 VITE_* 暴露给浏览器，不加前缀就不会被打进前端产物
APP_SECRET=63d98624f6aefe0046479fd060d4085a1c7d8c166144522d3bab3de7ede7f59b
