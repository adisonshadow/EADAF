{
  "name": "eadaf-api",
  "version": "1.1.0",
  "description": "EADAF Platform REST API Service",
  "main": "src/app.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/app.js",
    "dev:watch": "cross-env NODE_ENV=development nodemon src/app.js",
    "prod": "cross-env NODE_ENV=production node src/app.js",
    "start": "cross-env NODE_ENV=production node src/app.js",
    "pm2dev": "pm2 startOrReload ecosystem.config.cjs --only eadaf-api-dev",
    "pm2prod": "pm2 startOrReload ecosystem.config.cjs --only eadaf-api",
    "test": "jest",
    "test:unit": "node --test src/**/*.test.js",
    "lint": "eslint src/",
    "test-with-reset-db": "cross-env RESET_DB=true jest --config=jest.config.js",
    "init-db": "bash scripts/initdb.sh",
    "init-db-with-mock": "bash scripts/initdb.sh --with-mock",
    "init-db-with-aibase-seed": "bash scripts/initdb.sh --with-aibase-seed",
    "export-eadaf-ai-skills": "node scripts/export-eadaf-ai-skills.js",
    "migrate-eadaf-ai-skills": "bash scripts/apply-eadaf-ai-skills.sh",
    "db:maintenance": "bash scripts/db-maintenance.sh",
    "db:vacuum": "bash scripts/db-maintenance.sh VACUUM",
    "db:analyze": "bash scripts/db-maintenance.sh ANALYZE",
    "db:reindex": "bash scripts/db-maintenance.sh REINDEX",
    "db:maintenance:all": "bash scripts/db-maintenance.sh ALL",
    "db:backup": "bash scripts/backup-db-now.sh",
    "backup:now": "bash scripts/backup-db-now.sh",
    "db:backup:setup-cron": "bash scripts/setup-backup-cron.sh",
    "swagger": "node scripts/generate-swagger.js",
    "config:check": "node scripts/check-env.cjs",
    "config:example": "node scripts/check-env.cjs --fix-example",
    "compose:env": "node scripts/lib/load-env.cjs --dotenv > .env.compose",
    "compose:up": "npm run --silent compose:env && docker compose up -d",
    "compose:down": "docker compose down",
    "compose:mysql:up": "npm run --silent compose:env && docker compose -f docker-compose_with_MySQL.yml up -d",
    "compose:mysql:down": "docker compose -f docker-compose_with_MySQL.yml down",
    "migrate-uac-to-eadaf": "bash scripts/migrate-uac-to-eadaf.sh"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.4",
    "ajv": "^8.20.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "eslint": "^9.27.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.14.2",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-jwt": "^4.0.4",
    "koa-multer": "^1.0.2",
    "koa-router": "^12.0.1",
    "koa2-swagger-ui": "^5.11.0",
    "minio": "^8.0.7",
    "mongodb": "^6.21.0",
    "mysql2": "^3.14.0",
    "node-cron": "^3.0.3",
    "path-to-regexp": "6.3.0",
    "pg": "^8.15.6",
    "pg-hstore": "^2.3.4",
    "redis": "^4.7.1",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.2",
    "swagger-jsdoc": "^6.2.8",
    "typescript": "~5.8.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/jest": "^29.5.14",
    "cross-env": "^7.0.3",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "pm2": "^7.0.4",
    "supertest": "^7.1.0"
  }
}
