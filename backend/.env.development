# PostgreSQL (Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=25432
POSTGRES_DATABASE=eadaf_db
POSTGRES_USER=my_name
POSTGRES_PASSWORD=123456
POSTGRES_SCHEMA=uac
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=2000
POSTGRES_SSL=false

# 数据库备份（相对 EADAF_backend 根目录；未配置时 development 默认 db-backup）
DB_BACKUP_DIR=db-backup

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_PASSWORD=

# MySQL（可选，docker-compose_with_MySQL.yml，用于 BizData 存储）
MYSQL_PORT=23306
MYSQL_ROOT_PASSWORD=Root@123456
MYSQL_DATABASE=bizdata

# API
API_PORT=29526
# 0.0.0.0 = 监听所有网卡（局域网 / 公网）；仅本机可改为 127.0.0.1
API_HOST=0.0.0.0
# * = 回显任意 Origin（局域网 IP、公网域名均可）；收紧时改成逗号分隔白名单
CORS_ORIGIN=*

CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Security
JWT_SECRET=my-jwt-secret-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# SSO 访问令牌有效期（Phase 1 起收紧）。dev 先切 15m 验证"静默刷新"链路：
# 管理台与示例应用都已按 401 TOKEN_EXPIRED 自动刷新；**还没实现刷新的老应用请把它注释掉**
# （不设时沿用 JWT_EXPIRES_IN=24h）。登出立即失效不依赖这个值，靠 sid 撤销集。
SSO_ACCESS_TOKEN_TTL=15m

# Login verify
LOGIN_VERIFY_ENABLED=true
LOGIN_VERIFY_EXPIRES_IN=300

# SSO
SSO_REDIRECT_MODE=POST_REDIRECT
# 平台 issuer（令牌 iss / OIDC 发现文档 / back-channel logout 都用它）。
# 不设时按请求的 origin 推导（本地即 http://localhost:29526）；反代/多域名场景建议显式固定。
# SSO_ISSUER=
# 平台签名密钥（RS256）。不设时首次启动自动生成并落到 ./data/keys（已 gitignore）；
# 生产建议用下面两个 env 固定，避免容器重建换密钥导致已签发令牌全部失效。
# SSO_JWT_KEY_DIR=./data/keys
# SSO_JWT_PRIVATE_KEY=
# SSO_JWT_PUBLIC_KEY=

# Upload / 存储
UPLOAD_DEFAULT_TYPE=image
STORAGE_ROOT=upload_test
STORAGE_TUS_DIR_NAME=.tus
# TUS 分片上限（字节，默认 5GiB）与临时文件保留时长（毫秒，默认 24h）
STORAGE_TUS_MAX_SIZE=5368709120
STORAGE_TUS_EXPIRATION_MS=86400000
MINIO_REGION=us-east-1
# 系统内置 Bucket 的说明文案（不设时用代码里的默认文案）
# SYSTEM_STORAGE_BUCKET_DESCRIPTION=
# 图片裁剪缓存目录（相对后端工作目录）
IMG_CROP_CACHE_DIR=img_crop_cache

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_ROTATION_MAX_SIZE=20m
LOG_ROTATION_MAX_FILES=14d
LOG_ROTATION_ZIPPED=true
LOG_ERROR_MAX_FILES=30d
LOG_EXCEPTIONS_MAX_FILES=30d
LOG_REJECTIONS_MAX_FILES=30d

# AI Base
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AI_UPSTREAM_TIMEOUT_MS=60000
# 允许被 AI http_request 工具访问的受信主机（逗号分隔；空 = 仅内置默认名单）
AI_HTTP_TRUSTED_HOSTS=
# 工具调用日志（默认关闭；路径不设时为 logs/ai-tool-invoke-%DATE%.log，相对后端工作目录）
AI_TOOL_INVOKE_LOG_ENABLED=false
# AI_TOOL_INVOKE_LOG_FILE=
# 操作审计是否同步落库（默认 false = 异步）
OPERATION_AUDIT_SYNC=false

# 系统内置应用 EADAF（文件存储访问策略联调）
SYSTEM_APPLICATION_ID=10000000-0000-4000-8000-000000000002 # 本应用 ID
SYSTEM_APPLICATION_SECRET= # 本应用密钥；init-db 不写入密钥，请在应用管理页生成后自行配置
# 本地 MinIO：在 backend 目录执行 docker compose up -d minio（见 docker-compose.yml）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=eadaf
MINIO_SECRET_KEY=eadaf-minio-secret
MINIO_BUCKET=eadaf
SYSTEM_STORAGE_BUCKET_CODE=eadaf-system # 系统内置 Bucket 编码
SYSTEM_STORAGE_BUCKET_NAME=EADAF系统资源 # 系统内置 Bucket 名称
