NODE_ENV=development

# PostgreSQL (Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=25432
POSTGRES_DATABASE=eadaf_db
POSTGRES_USER=my_name
POSTGRES_PASSWORD=123456
POSTGRES_SCHEMA=uac
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=2000
POSTGRES_SSL=false

# 数据库备份（相对 EADAF_backend 根目录；未配置时 development 默认 db-backup）
DB_BACKUP_DIR=db-backup

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_PASSWORD=

# MySQL（可选，docker-compose_with_MySQL.yml，用于 BizData 存储）
MYSQL_PORT=23306
MYSQL_ROOT_PASSWORD=Root@123456
MYSQL_DATABASE=bizdata

# API
API_PORT=29526
# 0.0.0.0 = 监听所有网卡（局域网 / 公网）；仅本机可改为 127.0.0.1
API_HOST=0.0.0.0
# * = 回显任意 Origin（局域网 IP、公网域名均可）；收紧时改成逗号分隔白名单
CORS_ORIGIN=*

# 销售 Demo SQLite（由 yarn init-sales-demo-db 生成）
SALES_DEMO_DB_PATH=./data/sales-demo.db
SALES_DEMO_SQL_PATH=../EADAF_AIBase/scripts/sales-demo-db.sql
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Security
JWT_SECRET=my-jwt-secret-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Login verify
LOGIN_VERIFY_ENABLED=true
LOGIN_VERIFY_EXPIRES_IN=300

# SSO
SSO_REDIRECT_MODE=POST_REDIRECT

# Upload
UPLOAD_DEFAULT_TYPE=image

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_ROTATION_MAX_SIZE=20m
LOG_ROTATION_MAX_FILES=14d
LOG_ROTATION_ZIPPED=true
LOG_ERROR_MAX_FILES=30d
LOG_EXCEPTIONS_MAX_FILES=30d
LOG_REJECTIONS_MAX_FILES=30d

# AI Base
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AI_UPSTREAM_TIMEOUT_MS=60000

# 系统内置应用 EADAF（文件存储访问策略联调）
SYSTEM_APPLICATION_ID=10000000-0000-4000-8000-000000000002 # 本应用 ID
SYSTEM_APPLICATION_SECRET= # 本应用密钥；init-db 不写入密钥，请在应用管理页生成后自行配置
# 本地 MinIO：在 backend 目录执行 docker compose up -d minio（见 docker-compose.yml）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=eadaf
MINIO_SECRET_KEY=eadaf-minio-secret
MINIO_BUCKET=eadaf
SYSTEM_STORAGE_BUCKET_CODE=eadaf-system # 系统内置 Bucket 编码
SYSTEM_STORAGE_BUCKET_NAME=EADAF系统资源 # 系统内置 Bucket 名称
