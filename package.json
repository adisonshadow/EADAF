{
  "name": "EADAF-monorepo",
  "version": "1.2.6",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "killdev": "bash scripts/killdev.sh",
    "start": "bash scripts/preview.sh",
    "pm2dev": "pnpm --filter ./backend pm2dev && pnpm --filter ./frontend pm2dev",
    "pm2prod": "pnpm --filter ./backend pm2prod && pnpm --filter ./frontend pm2prod",
    "offline:deploy": "bash scripts/offline-deploy.sh",
    "offline:patch": "bash scripts/offline-patch.sh",
    "pack:eadaf": "bash scripts/deploy/pack-eadaf.sh",
    "pack:app": "bash scripts/deploy/pack-app.sh"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
