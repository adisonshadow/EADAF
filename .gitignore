# --- OS ---
.DS_Store
Thumbs.db

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Environment & secrets ---
# .env.development 入库：值就是本机 Docker 的默认值（与 backend/docker-compose.yml
# 的默认值一致），pnpm dev 开箱可用，不必每台机器再 cp 一次。
# 真实/个人密钥请写进 .env.local 或 .env.development.local（下面两行仍然忽略它们）。
.env
.env.local
.env.*.local
.env.production
.env.test
!.env.example

# --- Logs ---
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# eadaf-runtime 日志目录占位需入库
!eadaf-runtime/logs/
!eadaf-runtime/logs/**/
!eadaf-runtime/logs/**/.gitkeep

# --- Build output ---
dist/
dist-ssr/
build/
out/
/deploy-artifacts/*
!/deploy-artifacts/EADAF/
!/deploy-artifacts/APP/
/deploy-artifacts/EADAF/**
!/deploy-artifacts/EADAF/.gitkeep
/deploy-artifacts/APP/**
!/deploy-artifacts/APP/.gitkeep
/deploy-artifacts/.staging*/
*.tsbuildinfo

# --- Offline deploy: 跟踪脚本/配置，忽略大产物 ---
# 运行时 .env（模板用 env.template）
eadaf-runtime/.env
# 镜像 / 静态资源 / 下载的 Docker 二进制
eadaf-runtime/docker-images/**
!eadaf-runtime/docker-images/.gitkeep
eadaf-runtime/frontend/dist/
eadaf-runtime/centos-docker-static/docker-24.0.9.tgz
eadaf-runtime/centos-docker-static/docker-compose
eadaf-runtime/centos-docker-static/docker/
# 打包时从 backend / FPCU2 拷贝的 SQL 与 seed（可再生成）
eadaf-runtime/init-sql/
eadaf-runtime/init/fpcu-seed/
# 运行日志与标记
eadaf-runtime/logs/**/*.log
eadaf-runtime/data/.initialized
eadaf-runtime/data/.fpcu-seeded
# 发给客户的压缩包放在 releases/ 子目录
eadaf-runtime/releases/**
!eadaf-runtime/releases/.gitkeep
# 补丁解压临时目录（若落在仓库根）
eadaf-runtime-patch-*/
# 兼容旧路径：根目录曾放过整包 tar
/eadaf-runtime-*.tar.gz

# --- Test & coverage ---
coverage/
.nyc_output/

# --- Cache ---
.cache/
.turbo/
.eslintcache
.stylelintcache
*.swp
*.swo
*~
# AI / 编辑器原子写盘的暂存目录与临时文件（写完即删；进程被强杀时可能残留）
*.tmpdir/
*.tmp

# --- Editors ---
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Cursor (local plans / agent state) ---
.cursor/
.offline-fpcu2-staging/
.offline-fpcu2-staging-patch/

# --- 根目录临时导出（应用/平台导出 dump、报错日志等） ---
/tmp/

# --- EADAF_frontend ---
frontend/tmp/

# --- backend ---
backend/uploads/*
upload_test/
!backend/uploads/.gitkeep
backend/thumbsCache/*
backend/backups/
backend/db-backup/
backend/data/*.db
backend/src/resource/
backend/install/images/*.tar
backend/img_crop_cache

# --- AIBase_with_example ---
AIBase_with_example/ref-demo/
